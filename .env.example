# Groq powers requirements generation and adaptive interview questions.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Optional separate OpenAI-compatible embeddings provider. If unconfigured, local embeddings are used.
OPENAI_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Local persistence paths
APP_DATA_DIR=data
VECTOR_DB_PATH=data/chroma
